{
  "buildCommand": "cd server && npm install --legacy-peer-deps && npx prisma generate && cd ../client && npm install --legacy-peer-deps && npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/ready",
      "destination": "/api/index.js"
    },
    {
      "source": "/live",
      "destination": "/api/index.js"
    },
    {
      "source": "/metrics",
      "destination": "/api/index.js"
    },
    {
      "source": "/:path((?!api|health|ready|live|metrics).*)",
      "destination": "/index.html"
    }
  ]
}
